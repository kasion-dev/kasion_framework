{
  "name": "__APP_NAME__",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "check": "node scripts/check.mjs",
    "migrate": "wrangler d1 migrations apply __DB_NAME__ --remote",
    "migrate:local": "wrangler d1 migrations apply __DB_NAME__ --local",
    "deploy": "node scripts/check.mjs && wrangler deploy",
    "push:keys": "node scripts/gen_vapid.mjs",
    "icons": "sh scripts/make_icons.sh",
    "sounds": "python3 scripts/gen_sfx.py"
  },
  "devDependencies": { "wrangler": "^4.161.0" }
}
